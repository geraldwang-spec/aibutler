# body（體重與訓練）的 AI 設定範本
# 使用方式：在 body 資料夾裡複製成 body.env 再填值（cp body/body.env.example body/body.env）。
# body/body.env 已被 body/.gitignore 排除，金鑰不會被 commit。
# body 的 AI 設定只讀這個檔案，不讀專案的 .env。改完要重新啟動 python app.py。
# 沒有 body.env、或 BODY_LLM_BASE_URL／BODY_LLM_MODEL 是空的 → 不啟用 AI，只用規則解析。

# 對話模型（一句話解析、分析說明）
BODY_LLM_BASE_URL=https://api.openai.com/v1
BODY_LLM_MODEL=
BODY_LLM_API_KEY=
BODY_LLM_TIMEOUT=30
BODY_LLM_JSON_MODE=true
# 推理型模型的思考程度（選填，留空就不送）
BODY_LLM_REASONING_EFFORT=

# embedding（之後的 RAG 用；同一份索引要一直用同一個模型）
BODY_EMBED_MODEL=text-embedding-3-small
# 留空就沿用上面的網址與金鑰
BODY_EMBED_BASE_URL=
BODY_EMBED_API_KEY=
