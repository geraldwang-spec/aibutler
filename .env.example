# 複製成 .env 後填寫；.env 已排除 Git。請勿將密碼或金鑰貼入前端。
# 留空時會在 instance/ 自動建立本機 session 金鑰。
SECRET_KEY=
# 以下寄信資源請自行填入。未設定時頁面會以紅字提示無法寄送。
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=考試智伴
# starttls 常搭配 587；ssl 常搭配 465，依寄信服務規格填寫。
SMTP_SECURITY=starttls
# 部署 HTTPS 後設 true；本機 HTTP 保持 false。
COOKIE_SECURE=false

# Database: sqlite 或 mariadb。多人開發連遠端時使用 mariadb。
DB_TYPE=mariadb
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=utf8mb4

# 體重與訓練：一句話輸入的 AI 解析（OpenAI 相容格式；留空就只用規則解析）
# 金鑰只放在自己的 .env，不要 commit；並在供應商後台設定花費上限。
# 雲端（例如 Groq）：BODY_LLM_BASE_URL=https://api.groq.com/openai/v1，填 BODY_LLM_API_KEY
# 本機 Ollama：BODY_LLM_BASE_URL=http://127.0.0.1:11434/v1，BODY_LLM_API_KEY 留空
# 模型名稱以供應商的模型清單為準
BODY_LLM_BASE_URL=
BODY_LLM_MODEL=
BODY_LLM_API_KEY=
BODY_LLM_TIMEOUT=30
BODY_LLM_JSON_MODE=true
