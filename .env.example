# ============================================================
# AI Butler - REAL / HYBRID MODEL PROFILE
# SQLite is still used for convenient home validation.
# AI is no longer mock by default.
# ============================================================
APP_MODE=dev
SECRET_KEY=dev-only-change-before-public-release
COOKIE_SECURE=false

DB_TYPE=mariadb
DATABASE=instance/personal_ai_dev.db

# PostgreSQL + pgvector (switch later when DB_TYPE=postgresql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
AUTO_INIT_DB=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=考試智伴
SMTP_SECURITY=starttls

# ------------------------------------------------------------
# Local base model / classifier
# ------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3.5:4b

CLASSIFIER_PROVIDER=ollama
CLASSIFIER_BASE_URL=http://127.0.0.1:11434/v1
CLASSIFIER_API_KEY=
CLASSIFIER_MODEL=qwen3.5:4b

PARSER_PROVIDER=ollama
PARSER_BASE_URL=http://127.0.0.1:11434/v1
PARSER_API_KEY=
PARSER_MODEL=qwen3.5:4b

# ------------------------------------------------------------
# Cloud heavy roles - Groq
# Leave GROQ_API_KEY empty if you want to validate locally first.
# Every Groq role has local qwen3.5:4b fallback.
# ------------------------------------------------------------
GROQ_API_KEY=

GENERATOR_PROVIDER=groq
GENERATOR_BASE_URL=https://api.groq.com/openai/v1
GENERATOR_API_KEY=
GENERATOR_MODEL=qwen/qwen3.8-27b
GENERATOR_FALLBACK_PROVIDER=ollama
GENERATOR_FALLBACK_BASE_URL=http://127.0.0.1:11434/v1
GENERATOR_FALLBACK_API_KEY=
GENERATOR_FALLBACK_MODEL=qwen3.5:4b

REVIEWER_PROVIDER=groq
REVIEWER_BASE_URL=https://api.groq.com/openai/v1
REVIEWER_API_KEY=
REVIEWER_MODEL=qwen/qwen3.8-27b
REVIEWER_FALLBACK_PROVIDER=ollama
REVIEWER_FALLBACK_BASE_URL=http://127.0.0.1:11434/v1
REVIEWER_FALLBACK_API_KEY=
REVIEWER_FALLBACK_MODEL=qwen3.5:4b

COURSE_PROVIDER=groq
COURSE_BASE_URL=https://api.groq.com/openai/v1
COURSE_API_KEY=
COURSE_MODEL=openai/gpt-oss-120b
COURSE_FALLBACK_PROVIDER=ollama
COURSE_FALLBACK_BASE_URL=http://127.0.0.1:11434/v1
COURSE_FALLBACK_API_KEY=
COURSE_FALLBACK_MODEL=qwen3.5:4b

TUTOR_PROVIDER=groq
TUTOR_BASE_URL=https://api.groq.com/openai/v1
TUTOR_API_KEY=
TUTOR_MODEL=openai/gpt-oss-120b
TUTOR_FALLBACK_PROVIDER=ollama
TUTOR_FALLBACK_BASE_URL=http://127.0.0.1:11434/v1
TUTOR_FALLBACK_API_KEY=
TUTOR_FALLBACK_MODEL=qwen3.5:4b

# ------------------------------------------------------------
# Embedding / RAG
# ------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3

# ------------------------------------------------------------
# Voice Tutor - weights can be downloaded now; keep disabled
# until the microphone/TTS UI is validated.
# ------------------------------------------------------------
VOICE_ENABLED=false
STT_PROVIDER=faster_whisper
STT_MODEL=large-v3
TTS_PROVIDER=kokoro
TTS_MODEL=hexgrad/Kokoro-82M-v1.1-zh
TTS_LANGUAGE=z

CLOUDFLARE_TUNNEL_TOKEN=

DB_CHARSET=utf8mb4