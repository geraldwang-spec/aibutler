# 複製成 .env 後填寫；.env 已排除 Git。請勿將密碼或金鑰貼入前端。
# 留空時會在 instance/ 自動建立本機 session 金鑰。
SECRET_KEY=
# 以下寄信資源請自行填入。未設定時頁面會以紅字提示無法寄送。
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=考試智伴
# starttls 常搭配 587；ssl 常搭配 465，依寄信服務規格填寫。
SMTP_SECURITY=starttls
# 部署 HTTPS 後設 true；本機 HTTP 保持 false。
COOKIE_SECURE=false

# Database: sqlite 或 mariadb。多人開發連遠端時使用 mariadb。
DB_TYPE=mariadb
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=utf8mb4

# 體重與訓練：AI 功能（OpenAI 相容格式；BODY_LLM_* 留空就只用規則解析）
# 金鑰只放在自己的 .env，不要 commit；並在供應商後台設定用量通知與花費上限。
# OpenAI：BODY_LLM_BASE_URL=https://api.openai.com/v1
# 本機 Ollama：BODY_LLM_BASE_URL=http://127.0.0.1:11434/v1，BODY_LLM_API_KEY 留空
# 模型名稱以供應商的模型清單為準（一句話解析用最便宜的小模型就夠）
BODY_LLM_BASE_URL=
BODY_LLM_MODEL=
BODY_LLM_API_KEY=
BODY_LLM_TIMEOUT=30
BODY_LLM_JSON_MODE=true
# 推理型模型的思考程度（選填，留空就不送）
BODY_LLM_REASONING_EFFORT=
# RAG 用的 embedding 模型（選填）；同一份索引要一直用同一個模型，換模型要全部重算
# OpenAI 例如 text-embedding-3-small；BASE_URL / API_KEY 留空就沿用上面的 BODY_LLM_*
BODY_EMBED_MODEL=
BODY_EMBED_BASE_URL=
BODY_EMBED_API_KEY=
