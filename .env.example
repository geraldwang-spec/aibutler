# ============================================================
# ★★★ GROQ API KEY：只要在下面 = 後面貼一次 KEY，所有文字 AI 共用 ★★★
# 範例：GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 請勿加引號，也不要把真正的 KEY 上傳到 GitHub。
# ============================================================
GROQ_API_KEY=

# ============================================================
# AI Butler - REAL / HYBRID MODEL PROFILE
# SQLite is still used for convenient home validation.
# AI is no longer mock by default.
# ============================================================
APP_MODE=dev
SECRET_KEY=dev-only-change-before-public-release
COOKIE_SECURE=false

DB_TYPE=mariadb
DATABASE=instance/personal_ai_dev.db

# PostgreSQL + pgvector (switch later when DB_TYPE=postgresql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
AUTO_INIT_DB=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=考試智伴
SMTP_SECURITY=starttls

# ------------------------------------------------------------
# Text LLM / classifier / parser - Groq API (single shared key)
# ------------------------------------------------------------
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b

CLASSIFIER_PROVIDER=groq
CLASSIFIER_BASE_URL=https://api.groq.com/openai/v1
CLASSIFIER_API_KEY=
CLASSIFIER_MODEL=qwen/qwen3.8-27b

PARSER_PROVIDER=groq
PARSER_BASE_URL=https://api.groq.com/openai/v1
PARSER_API_KEY=
PARSER_MODEL=qwen/qwen3.8-27b

# ------------------------------------------------------------
# Groq cloud roles - all text LLM calls use the ONE GROQ_API_KEY above
# No local LLM fallback: if Groq is unavailable, show an API error instead of loading Qwen on GPU.
# ------------------------------------------------------------

GENERATOR_PROVIDER=groq
GENERATOR_BASE_URL=https://api.groq.com/openai/v1
GENERATOR_API_KEY=
GENERATOR_MODEL=qwen/qwen3.8-27b
GENERATOR_FALLBACK_PROVIDER=
GENERATOR_FALLBACK_BASE_URL=
GENERATOR_FALLBACK_API_KEY=
GENERATOR_FALLBACK_MODEL=

REVIEWER_PROVIDER=groq
REVIEWER_BASE_URL=https://api.groq.com/openai/v1
REVIEWER_API_KEY=
REVIEWER_MODEL=qwen/qwen3.8-27b
REVIEWER_FALLBACK_PROVIDER=
REVIEWER_FALLBACK_BASE_URL=
REVIEWER_FALLBACK_API_KEY=
REVIEWER_FALLBACK_MODEL=

COURSE_PROVIDER=groq
COURSE_BASE_URL=https://api.groq.com/openai/v1
COURSE_API_KEY=
COURSE_MODEL=qwen/qwen3.8-27b
COURSE_FALLBACK_PROVIDER=
COURSE_FALLBACK_BASE_URL=
COURSE_FALLBACK_API_KEY=
COURSE_FALLBACK_MODEL=

TUTOR_PROVIDER=groq
TUTOR_BASE_URL=https://api.groq.com/openai/v1
TUTOR_API_KEY=
TUTOR_MODEL=qwen/qwen3.8-27b
TUTOR_FALLBACK_PROVIDER=
TUTOR_FALLBACK_BASE_URL=
TUTOR_FALLBACK_API_KEY=
TUTOR_FALLBACK_MODEL=

# ------------------------------------------------------------
# Embedding / RAG
# ------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3

# ------------------------------------------------------------
# Voice Tutor - weights can be downloaded now; keep disabled
# until the microphone/TTS UI is validated.
# ------------------------------------------------------------
VOICE_ENABLED=false
STT_PROVIDER=faster_whisper
STT_MODEL=large-v3
TTS_PROVIDER=kokoro
TTS_MODEL=hexgrad/Kokoro-82M-v1.1-zh
TTS_LANGUAGE=z

CLOUDFLARE_TUNNEL_TOKEN=

DB_CHARSET=utf8mb4

# 體重與訓練（body）的 AI 設定不放在這裡：請複製 body/body.env.example 成 body/body.env 再填值。
